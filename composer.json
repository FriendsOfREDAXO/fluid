{
    "name": "friendsofredaxo/fluid",
    "description": "Blöcke mit Feldschema und Bearbeiten direkt auf der Website für REDAXO 6",
    "type": "redaxo-addon",
    "license": "MIT",
    "keywords": [
        "redaxo",
        "redaxo-addon",
        "redaxo6",
        "frontend-editing",
        "page-builder",
        "blocks",
        "yform",
        "cms"
    ],
    "homepage": "https://github.com/FriendsOfREDAXO/fluid",
    "authors": [
        {
            "name": "Thomas Skerbis",
            "homepage": "https://klxm.de"
        },
        {
            "name": "Friends Of REDAXO",
            "homepage": "https://friendsofredaxo.github.io"
        }
    ],
    "support": {
        "issues": "https://github.com/FriendsOfREDAXO/fluid/issues",
        "source": "https://github.com/FriendsOfREDAXO/fluid"
    },
    "require": {
        "php": "^8.5",
        "redaxo/core": "^6.0@dev",
        "loupe/loupe": "^1.1"
    },
    "suggest": {
        "yakamara/yform": "Formulare, Datenlisten, Postfach und das Feld „Fluid-Blöcke“ (YForm 6)",
        "friendsofredaxo/image_editor": "Bilder auf der Website zuschneiden, drehen, Fokuspunkt setzen"
    },
    "autoload": {
        "psr-4": {
            "FriendsOfRedaxo\\Fluid\\": "src/",
            "FriendsOfRedaxo\\Fluid\\Kit\\Fluid\\": "kits/fluid/src/"
        }
    },
    "extra": {
        "redaxo": {
            "addon-class": "FriendsOfRedaxo\\Fluid\\FluidAddon"
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
